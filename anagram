
#include <stdio.h>
#include <string.h>

int main() {
    char a[1000], b[1000];
    int count[256] = {0};
    int flag = 1;

    scanf("%999s %999s", a, b);

    if (strlen(a) != strlen(b)) {
        flag = 0;
    }
    else {
        for (int i = 0; a[i] != '\0'; i++) {
            count[(unsigned char)a[i]]++;
            count[(unsigned char)b[i]]--;
        }

        for (int i = 0; i < 256; i++) {
            if (count[i] != 0) {
                flag = 0;
                break;
            }
        }
    }

    if (flag)
        printf("Anagram");
    else
        printf("Not Anagram");

    return 0;
}
